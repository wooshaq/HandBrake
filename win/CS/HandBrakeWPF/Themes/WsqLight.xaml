<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WsQ modern layout palette (light). Used by Views/Styles/WsqStyles.xaml -->
    <SolidColorBrush x:Key="Wsq.Background" Color="#F3F4F6" />
    <SolidColorBrush x:Key="Wsq.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Wsq.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Wsq.CardBorder" Color="#E2E4E9" />
    <SolidColorBrush x:Key="Wsq.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Wsq.Hover" Color="#ECEDF1" />
    <SolidColorBrush x:Key="Wsq.Pressed" Color="#E1E3E8" />
    <SolidColorBrush x:Key="Wsq.TabActive" Color="#E6E8EC" />
    <SolidColorBrush x:Key="Wsq.Text" Color="#16181D" />
    <SolidColorBrush x:Key="Wsq.Muted" Color="#5C616C" />
    <SolidColorBrush x:Key="Wsq.Accent" Color="#F5B64A" />
    <SolidColorBrush x:Key="Wsq.AccentHover" Color="#FFC866" />
    <SolidColorBrush x:Key="Wsq.AccentPressed" Color="#E0A23A" />
    <SolidColorBrush x:Key="Wsq.AccentText" Color="#1A1305" />
    <SolidColorBrush x:Key="Wsq.Danger" Color="#FDECEC" />
    <SolidColorBrush x:Key="Wsq.DangerBorder" Color="#F2B8B8" />
    <SolidColorBrush x:Key="Wsq.DangerText" Color="#9B1C1C" />
    <SolidColorBrush x:Key="Wsq.Badge" Color="#F5B64A" />
    <SolidColorBrush x:Key="Wsq.BadgeText" Color="#1A1305" />

</ResourceDictionary>
