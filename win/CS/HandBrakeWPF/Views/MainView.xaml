<UserControl x:Class="HandBrakeWPF.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="clr-namespace:HandBrakeWPF.Controls"
             xmlns:Converters="clr-namespace:HandBrakeWPF.Converters"
             xmlns:Properties="clr-namespace:HandBrakeWPF.Properties"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviours="clr-namespace:HandBrakeWPF.Behaviours"
             xmlns:main="clr-namespace:HandBrakeWPF.Converters.Main"
             xmlns:views="clr-namespace:HandBrakeWPF.Views"
             AllowDrop="True"
             FontSize="12"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             x:Name="mainView"
             >

    <UserControl.Resources>
        <Converters:BooleanConverter x:Key="booleanConverter" />
        <Converters:PresetsMenuConverter x:Key="presetsMenuConverter"/>
        <Converters:LongToIntConverter x:Key="longToIntConverter" />
        <Converters:BooleanConverter x:Key="NotBooleanConverter" />
        <Converters:ThemeImageConverter x:Key="themeConverter" />
        <Converters:EnumComboConverter x:Key="enumComboConverter" />
        <main:PointToPointConverter x:Key="PointToPointConverter" />

        <Converters:BooleanToVisibilityConverter x:Key="boolToVisConverter" />

        <Style TargetType="MenuItem">
            <Setter Property="ToolTipService.InitialShowDelay" Value="1000"/>
        </Style>

    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Wsq.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Menu and Taskbar  -->
        <StackPanel Grid.Row="0" IsEnabled="{Binding IsNavigationEnabled, Converter={StaticResource booleanConverter}, ConverterParameter=false}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Orientation="Vertical">
            <!--  Main Menu  -->
            <Menu MinHeight="26" x:Name="mainAppMenu" Background="{DynamicResource Wsq.Surface}" Padding="10,2,10,0" Visibility="{Binding IsLegacyMenuShown, Converter={StaticResource boolToVisConverter}}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">
                <Menu.Resources>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="MinHeight" Value="23" />
                    </Style>
                </Menu.Resources>
                <MenuItem Header="{x:Static Properties:Resources.MainView_FileMenu}">
                    <MenuItem Header="{x:Static Properties:Resources.MainView_SourceOpen}" Command="{Binding RelayCommand}" CommandParameter="SelectSourceWindow" InputGestureText="Alt + O" />
                    <Separator />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_StartEncode}" Command="{Binding RelayCommand}" CommandParameter="StartEncode" InputGestureText="Ctrl + E"
                              IsEnabled="{Binding IsEncoding, Converter={StaticResource NotBooleanConverter}, ConverterParameter=true}" />

                    <MenuItem Header="{x:Static Properties:Resources.MainView_Pause}" Command="{Binding RelayCommand}" CommandParameter="PauseEncode" InputGestureText="Alt + P"
                              IsEnabled="{Binding IsEncoding, Converter={StaticResource NotBooleanConverter}, ConverterParameter=false}" />

                    <MenuItem Header="{x:Static Properties:Resources.MainView_Stop}" Command="{Binding RelayCommand}" CommandParameter="StopEncode" InputGestureText="Ctrl + K"
                              IsEnabled="{Binding IsEncoding, Converter={StaticResource NotBooleanConverter}, ConverterParameter=false}" />
                    <Separator />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_Exit}" Command="{Binding RelayCommand}" CommandParameter="ExitApplication"  InputGestureText="Alt + F4" />
                </MenuItem>

                <MenuItem Header="{x:Static Properties:Resources.MainView_ToolsMenu}">
                    <MenuItem Header="{x:Static Properties:Resources.MainView_ShowQueueMenu}" Command="{Binding RelayCommand}" CommandParameter="OpenQueueWindow" InputGestureText="Ctrl + Q">
                        <MenuItem.Icon>
                            <Image Width="16" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='Queue.png'}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{x:Static Properties:Resources.MainView_ActivityLogMenu}" Command="{Binding RelayCommand}" CommandParameter="OpenLogWindow"  InputGestureText="Ctrl + L">
                        <MenuItem.Icon>
                            <Image Width="16" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='Activity.png'}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{Binding  ShowHideMenuText}" Command="{Binding RelayCommand}" CommandParameter="ShowHideMenu" />
                    <Separator />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_PreferencesMenu}" Command="{Binding RelayCommand}" CommandParameter="OpenOptionsWindow">
                        <MenuItem.Icon>
                            <Image Width="16" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='Settings.png'}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="{x:Static Properties:Resources.MainView_PresetsMenu}" x:Name="presetMenu">

                    <MenuItem Header="{x:Static Properties:Resources.MainView_PresetsMenu}" ItemsSource="{Binding PresetsCategories, Converter={StaticResource presetsMenuConverter}}" />
                    <Separator />
                    <MenuItem Header="{x:Static Properties:Resources.AddPresetView_AddPreset}" Command="{Binding RelayCommand}" CommandParameter="PresetAdd" />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_UpdateSelectedPreset}" Command="{Binding RelayCommand}" CommandParameter="PresetUpdate" />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_SetCurrentAsDefault}" Command="{Binding RelayCommand}" CommandParameter="PresetSetDefault" />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_PresetManage}" Command="{Binding RelayCommand}" CommandParameter="PresetManage" />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_PresetRemove}" Command="{Binding RelayCommand}" CommandParameter="PresetRemoveSelected" />
                    <Separator />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_ImportFromFile}" Command="{Binding RelayCommand}" CommandParameter="PresetImport" />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_ExportToFile}" Command="{Binding RelayCommand}" CommandParameter="PresetExport" />
                    <Separator />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_ResetPresets}" Command="{Binding RelayCommand}" CommandParameter="PresetReset" />
                    <MenuItem Header="{x:Static Properties:Resources.ManagePresetView_DeleteBuiltIn}" Command="{Binding RelayCommand}" CommandParameter="PresetDeleteBuildIn" />
                </MenuItem>

                <MenuItem Header="{x:Static Properties:Resources.MainView_QueueMenu}" x:Name="queueMenu" Visibility="{Binding HasSource, Converter={StaticResource booleanConverter}, ConverterParameter=false}">
                    <MenuItem Header="{x:Static Properties:Resources.MainView_ShowQueue}" Command="{Binding RelayCommand}" CommandParameter="OpenQueueWindow"  InputGestureText="Ctrl + Q" />
                    <Separator />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_AddToQueue}" Command="{Binding RelayCommand}" CommandParameter="AddAllToQueue"  InputGestureText="Alt + A" />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_AddSelection}" Command="{Binding RelayCommand}" CommandParameter="AddSelectionToQueue" InputGestureText="Ctrl + Shift + A" />
                    <Separator />
                    <MenuItem x:Name="queueRecoveryMenuItem" Header="{x:Static Properties:Resources.SourceSelection_QueueArchiveRecovery}" Command="{Binding RelayCommand}" CommandParameter="RecoverQueue" />

                </MenuItem>

                <MenuItem Header="{x:Static Properties:Resources.MainView_HelpMenu}">
                    <MenuItem Header="{x:Static Properties:Resources.MainView_HandBrakeDocs}" Command="{Binding RelayCommand}" CommandParameter="LaunchHelp" InputGestureText="F1">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16"  Source="Images/information.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_CheckForUpdates}" Command="{Binding RelayCommand}" CommandParameter="CheckForUpdates" />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_NightlyBuildsUpdate}" Command="{Binding RelayCommand}" CommandParameter="NightlyUpdate" Visibility="{Binding IsNightly, Converter={StaticResource boolToVisConverter}}" />
                    <Separator />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_About}" Command="{Binding RelayCommand}" CommandParameter="OpenAboutApplication" />
                </MenuItem>

                <MenuItem Header="{x:Static Properties:Resources.MainView_DebugMenu}" Visibility="{Binding IsNightly, Converter={StaticResource boolToVisConverter}}">
                    <MenuItem Header="{x:Static Properties:Resources.MainView_DebugExportData}" Command="{Binding RelayCommand}" CommandParameter="ExportSourceData" />
                    <MenuItem Header="{x:Static Properties:Resources.MainView_DebugImportData}" Command="{Binding RelayCommand}" CommandParameter="ImportSourceData" />
                    <Separator/>
                    <MenuItem Header="{x:Static Properties:Resources.MainView_DebugQualitySweep}" Command="{Binding AddToQueueQualitySweepCommand}" />
                </MenuItem>
            </Menu>

            <!--  WsQ header bar  -->
            <Border x:Name="headerBar" Background="{DynamicResource Wsq.Surface}" BorderBrush="{DynamicResource Wsq.CardBorder}" BorderThickness="0,0,0,1" Padding="16,10">
                <Border.ContextMenu>
                    <ContextMenu AutomationProperties.Name="Toolbar Context Menu">
                        <MenuItem Header="{Binding  ShowHideMenuText}" Command="{Binding RelayCommand}" CommandParameter="ShowHideMenu" />
                        <Separator />
                        <MenuItem Header="{Binding ShowAddAllMenuName}" Command="{Binding RelayCommand}" CommandParameter="FlipAddAllToQueue" />
                        <MenuItem Header="{Binding ShowAddSelectionMenuName}" Command="{Binding RelayCommand}" CommandParameter="FlipAddSelectionToQueue" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo + source -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Wsq.Accent}" Margin="0,0,10,0">
                            <Path Data="M 7,4 L 7,20 M 17,4 L 17,20 M 7,12 L 17,12" Stroke="{DynamicResource Wsq.AccentText}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="HandBrake" FontSize="15" FontWeight="Bold" Style="{StaticResource WsqText}" Margin="0,0,16,0" />

                        <Button Name="SelectSource" x:Uid="Choose Source" AutomationProperties.Name="{x:Static Properties:Resources.MainView_SourceOpen}"
                                Style="{StaticResource WsqButton}" Command="{Binding RelayCommand}" CommandParameter="SelectSourceWindow">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='Source.png'}"/>
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource WsqText}" Text="{x:Static Properties:Resources.MainView_SourceOpen}"/>
                            </StackPanel>
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="{x:Static Properties:Resources.MainView_SourceOpen}"/>
                                    <LineBreak/>
                                    <Run Text="Alt + O" FontStyle="Italic"/>
                                </TextBlock>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>

                    <!-- Actions -->
                    <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                               KeyboardNavigation.TabNavigation="Continue">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource WsqGhostButton}">
                                <Setter Property="Margin" Value="4,0,0,0" />
                            </Style>
                        </WrapPanel.Resources>

                        <Button Name="Preview" AutomationProperties.Name="{x:Static Properties:Resources.MainView_ShowPreview}" Command="{Binding RelayCommand}" CommandParameter="OpenPreviewWindow"
                                ToolTip="{x:Static Properties:Resources.MainView_ShowPreview}">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='Preview.png'}"/>
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource WsqText}" Text="{x:Static Properties:Resources.MainView_ShowPreview}"/>
                            </StackPanel>
                        </Button>

                        <Button Name="ActivityWindow" AutomationProperties.Name="Activity Window" Command="{Binding RelayCommand}" CommandParameter="OpenLogWindow">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='Activity2.png'}"/>
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource WsqText}" Text="{x:Static Properties:Resources.MainView_ActivityLog}"/>
                            </StackPanel>
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="{x:Static Properties:Resources.MainView_ActivityLog}"/>
                                    <LineBreak/>
                                    <Run Text="Ctrl + L" FontStyle="Italic"/>
                                </TextBlock>
                            </Button.ToolTip>
                        </Button>

                        <Button Name="ShowQueue" AutomationProperties.Name="Queue" Command="{Binding RelayCommand}" CommandParameter="OpenQueueWindow">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='Queue.png'}"/>
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource WsqText}" Text="{Binding QueueLabel, FallbackValue='{x:Static Properties:Resources.MainView_ShowQueue}'}"/>
                                <Border Background="{DynamicResource Wsq.Badge}" CornerRadius="9" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="20"
                                        Visibility="{Binding IsQueueCountVisible, Converter={StaticResource boolToVisConverter}}">
                                    <TextBlock Text="{Binding QueueCount}" Foreground="{DynamicResource Wsq.BadgeText}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="7,1" />
                                </Border>
                            </StackPanel>
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="{x:Static Properties:Resources.MainView_ShowQueue}"/>
                                    <LineBreak/>
                                    <Run Text="Ctrl + Q" FontStyle="Italic"/>
                                </TextBlock>
                            </Button.ToolTip>
                        </Button>

                        <Border Width="1" Height="24" Margin="10,0,6,0" Background="{DynamicResource Wsq.CardBorder}" VerticalAlignment="Center" />

                        <Button x:Name="AddToQueueBtn" Style="{StaticResource WsqButton}" Margin="4,0,0,0" PreviewMouseLeftButtonDown="AddToQueue_PreviewMouseDown" ContextMenuService.IsEnabled="False"
                                AutomationProperties.Name="{x:Static Properties:Resources.MainView_AddToQueue}" PreviewKeyDown="AddToQueueBtn_OnKeyDown">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='AddToQueue.png'}" />
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource WsqText}" Text="{x:Static Properties:Resources.MainView_AddToQueue}" />
                                <Grid x:Name="dropdown" Background="Transparent" Margin="8,-8,-8,-8" Width="26">
                                    <Border Width="1" HorizontalAlignment="Left" Background="{DynamicResource Wsq.CardBorder}" Margin="0,6" IsHitTestVisible="False" />
                                    <Path x:Name="dropdownArrow" Height="5" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource Wsq.Text}" />
                                </Grid>
                            </StackPanel>
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="{x:Static Properties:Resources.MainView_AddToQueue}"/>
                                    <LineBreak/>
                                    <Run Text="Alt + A" FontStyle="Italic"/>
                                </TextBlock>
                            </Button.ToolTip>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static Properties:Resources.MainView_AddCurrent}" Command="{Binding RelayCommand}" CommandParameter="AddToQueueWithErrorHandling" AutomationProperties.Name="Add Current" InputGestureText="Alt + A" />
                                    <MenuItem Header="{x:Static Properties:Resources.MainView_AddAll}" Command="{Binding RelayCommand}" CommandParameter="AddAllToQueue" AutomationProperties.Name="Add all to Queue" InputGestureText="Ctrl + Alt + A" />
                                    <MenuItem Header="{x:Static Properties:Resources.MainView_AddSelection}" Command="{Binding RelayCommand}" CommandParameter="AddSelectionToQueue" AutomationProperties.Name="Add Selection to Queue" InputGestureText="Ctrl + Shift + A" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Name="AddSelectionToQueue" Style="{StaticResource WsqButton}" Margin="4,0,0,0" AutomationProperties.Name="{x:Static Properties:Resources.MainView_AddSelection}"
                                Command="{Binding RelayCommand}" CommandParameter="AddSelectionToQueue"
                                Visibility="{Binding ShowAddSelectionToQueue, Converter={StaticResource boolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='AddToQueue.png'}"/>
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource WsqText}" Text="{x:Static Properties:Resources.MainView_AddSelection}"/>
                            </StackPanel>
                        </Button>

                        <Button Name="AddAllToQueue" Style="{StaticResource WsqButton}" Margin="4,0,0,0" AutomationProperties.Name="{x:Static Properties:Resources.MainView_AddAll}"
                                Command="{Binding RelayCommand}" CommandParameter="AddAllToQueue"
                                Visibility="{Binding ShowAddAllToQueue, Converter={StaticResource boolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='AddToQueue.png'}"/>
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource WsqText}" Text="{x:Static Properties:Resources.MainView_AddAll}"/>
                            </StackPanel>
                        </Button>

                        <Button Name="Pause" Style="{StaticResource WsqButton}" Margin="8,0,0,0" AutomationProperties.Name="{x:Static Properties:Resources.MainView_Pause}"
                                Command="{Binding RelayCommand}" CommandParameter="PauseEncode"
                                Visibility="{Binding IsEncoding, Converter={StaticResource boolToVisConverter}, ConverterParameter=false}">
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="{x:Static Properties:Resources.MainView_Pause}"/>
                                    <LineBreak/>
                                    <Run Text="Alt + P" FontStyle="Italic"/>
                                </TextBlock>
                            </Button.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Source="Images/Pause.png"/>
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource WsqText}" Text="{x:Static Properties:Resources.MainView_Pause}"/>
                            </StackPanel>
                        </Button>

                        <Button Name="Stop" Style="{StaticResource WsqDangerButton}" Margin="4,0,0,0" AutomationProperties.Name="{x:Static Properties:Resources.MainView_Stop}"
                                Command="{Binding RelayCommand}" CommandParameter="StopEncode"
                                Visibility="{Binding IsEncoding, Converter={StaticResource boolToVisConverter}, ConverterParameter=false}">
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="{x:Static Properties:Resources.MainView_Stop}"/>
                                    <LineBreak/>
                                    <Run Text="Ctrl + K" FontStyle="Italic"/>
                                </TextBlock>
                            </Button.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Source="Images/stop.png"/>
                                <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource Wsq.DangerText}" VerticalAlignment="Center" Text="{x:Static Properties:Resources.MainView_Stop}"/>
                            </StackPanel>
                        </Button>

                        <Button Name="Start" Style="{StaticResource WsqPrimaryButton}" Margin="8,0,0,0" AutomationProperties.Name="{x:Static Properties:Resources.MainView_StartEncode}"
                                Command="{Binding RelayCommand}" CommandParameter="StartEncode"
                                Visibility="{Binding IsEncoding, Converter={StaticResource boolToVisConverter}, ConverterParameter=true}">
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="{x:Static Properties:Resources.MainView_StartEncode}"/>
                                    <LineBreak/>
                                    <Run Text="Ctrl + E" FontStyle="Italic"/>
                                </TextBlock>
                            </Button.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 0,0 L 10,6 L 0,12 Z" Fill="{DynamicResource Wsq.AccentText}" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource Wsq.AccentText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Text="{Binding StartLabel, FallbackValue='{x:Static Properties:Resources.MainView_StartEncode}'}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="infoButton" Margin="8,0,0,0" PreviewMouseLeftButtonDown="InfoButton_OnPreviewMouseLeftButtonDown" PreviewKeyDown="InfoButton_OnPreviewKeyDown"
                                AutomationProperties.Name="{x:Static Properties:Resources.MainView_Options}" ToolTip="{x:Static Properties:Resources.MainView_Options}"
                                Visibility="{Binding IsLegacyMenuShown, Converter={StaticResource boolToVisConverter}, ConverterParameter=true}">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='Settings.png'}" />
                                <Path Height="5" Margin="6,0,0,0" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource Wsq.Text}" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static Properties:Resources.MainView_HandBrakeDocs}" Command="{Binding RelayCommand}" CommandParameter="LaunchHelp" InputGestureText="F1">
                                        <MenuItem.Icon>
                                            <Image Width="16" Height="16"  Source="Images/information.png" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{Binding  ShowHideMenuText}" Command="{Binding RelayCommand}" CommandParameter="ShowHideMenu" />
                                    <Separator />
                                    <MenuItem x:Name="queueRecoveryMenuItem2" Header="{x:Static Properties:Resources.SourceSelection_QueueArchiveRecovery}" Command="{Binding RelayCommand}" CommandParameter="RecoverQueue" />
                                    <Separator />
                                    <MenuItem Header="{x:Static Properties:Resources.MainView_CheckForUpdates}" Command="{Binding RelayCommand}" CommandParameter="CheckForUpdates" />
                                    <MenuItem Header="{x:Static Properties:Resources.MainView_NightlyBuildsUpdate}" Command="{Binding RelayCommand}" CommandParameter="NightlyUpdate" Visibility="{Binding IsNightly, Converter={StaticResource boolToVisConverter}}" />
                                    <Separator />
                                    <MenuItem Header="{x:Static Properties:Resources.MainView_PreferencesMenu}" Command="{Binding RelayCommand}" CommandParameter="OpenOptionsWindow">
                                        <MenuItem.Icon>
                                            <Image Width="16" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='Settings.png'}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{x:Static Properties:Resources.MainView_About}" Command="{Binding RelayCommand}" CommandParameter="OpenAboutApplication" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!--  Main Body  -->
        <Grid Grid.Row="1" x:Name="mainBodyGrid" Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition x:Name="tabContentArea" Height="*" />
            </Grid.RowDefinitions>

            <!--  Source card  -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource WsqCard}"
                    IsEnabled="{Binding HasSource, Converter={StaticResource booleanConverter}, ConverterParameter=false}">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Preview thumbnail (same frame as the Summary tab), click to open the preview window -->
                <Border Grid.Column="0" Width="192" Height="108" CornerRadius="10" Margin="0,0,18,0" VerticalAlignment="Top" Cursor="Hand"
                        Background="#0B0C0E" BorderBrush="{DynamicResource Wsq.CardBorder}" BorderThickness="1"
                        ToolTip="{x:Static Properties:Resources.MainView_ShowPreview}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding RelayCommand}" CommandParameter="OpenPreviewWindow" />
                    </Border.InputBindings>
                    <Border CornerRadius="9">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding SummaryViewModel.PreviewImage}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <TextBlock Text="{x:Static Properties:Resources.MainView_Source}" Style="{StaticResource WsqLabel}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Path=SourceLabel}" ToolTip="{Binding Path=SourceLabel}" Style="{StaticResource WsqTitle}" MaxWidth="560" />
                        <TextBlock Grid.Column="1" Text="{Binding SourceInfo}" Style="{StaticResource WsqMutedText}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{x:Static Properties:Resources.MainView_Title}" Style="{StaticResource WsqLabel}" />
                            <ComboBox Name="Titles" MinWidth="240" MaxWidth="360" MaxDropDownHeight="400"
                                      ItemsSource="{Binding ScannedSource.Titles}"
                                      ToolTip="{x:Static Properties:ResourcesTooltips.MainView_Title}"
                                      SelectedItem="{Binding Path=SelectedTitle}" DropDownClosed="Titles_OnDropDownClosed" DropDownOpened="Titles_OnDropDownOpened" >
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{x:Static Properties:Resources.MainView_Angle}" Style="{StaticResource WsqLabel}" />
                            <ComboBox Name="Angles" MinWidth="60"
                                      ItemsSource="{Binding Angles}"
                                      SelectedItem="{Binding SelectedAngle}"
                                      ToolTip="{x:Static Properties:ResourcesTooltips.MainView_Angle}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{x:Static Properties:Resources.MainView_Range}" Style="{StaticResource WsqLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Name="PointToPointMode" MinWidth="90"
                                          ItemsSource="{Binding RangeMode, Converter={StaticResource PointToPointConverter}}" ToolTip="{x:Static Properties:ResourcesTooltips.MainView_Range}"
                                          SelectedItem="{Binding SelectedPointToPoint, Converter={StaticResource PointToPointConverter}}" />
                                <ComboBox Name="StartPoint" MinWidth="60" Margin="6,2,0,2"
                                          ItemsSource="{Binding StartEndRangeItems}"
                                          SelectedItem="{Binding SelectedStartPoint, Converter={StaticResource longToIntConverter}}"
                                          ToolTip="{x:Static Properties:ResourcesTooltips.MainView_StartPoint}"
                                          Visibility="{Binding ShowTextEntryForPointToPointMode, Converter={StaticResource boolToVisConverter}, ConverterParameter=true}" />
                                <Controls:TimeSpanBox Number="{Binding SelectedStartPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Minimum="0" AllowEmpty="False" ShowTimeSpan="{Binding IsTimespanRange}"
                                                      ToolTip="{x:Static Properties:ResourcesTooltips.MainView_StartPoint}"
                                                      MinWidth="72" Margin="6,0,0,0"
                                                      Visibility="{Binding ShowTextEntryForPointToPointMode, Converter={StaticResource boolToVisConverter}, ConverterParameter=false}" />
                                <TextBlock Margin="6,0,0,0" Style="{StaticResource WsqMutedText}" Text="{x:Static Properties:Resources.MainView_through}" />
                                <ComboBox Name="EndPoint" MinWidth="60" Margin="6,2,0,2"
                                          ItemsSource="{Binding StartEndRangeItems}"
                                          SelectedItem="{Binding SelectedEndPoint, Converter={StaticResource longToIntConverter}}"
                                          ToolTip="{x:Static Properties:ResourcesTooltips.MainView_EndPoint}"
                                          Visibility="{Binding ShowTextEntryForPointToPointMode, Converter={StaticResource boolToVisConverter}, ConverterParameter=true}" />
                                <Controls:TimeSpanBox Number="{Binding SelectedEndPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Minimum="0" AllowEmpty="False" ShowTimeSpan="{Binding IsTimespanRange}"
                                                      ToolTip="{x:Static Properties:ResourcesTooltips.MainView_EndPoint}"
                                                      MinWidth="72" Margin="6,0,0,0"
                                                      Visibility="{Binding ShowTextEntryForPointToPointMode, Converter={StaticResource boolToVisConverter}, ConverterParameter=false}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel ToolTip="{x:Static Properties:ResourcesTooltips.MainView_Duration}">
                            <TextBlock Text="{x:Static Properties:Resources.MainView_Duration}" Style="{StaticResource WsqLabel}" />
                            <TextBlock Text="{Binding Duration}" Style="{StaticResource WsqText}" FontFamily="Consolas" FontSize="13" Margin="0,5,0,0" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
                </Grid>
            </Border>

            <!--  Tab Control  -->
            <TabControl Name="tabControl" Grid.Row="2" Grid.Column="0" Style="{StaticResource WsqTabControl}"
                        IsEnabled="{Binding HasSource, Converter={StaticResource booleanConverter}, ConverterParameter=false}"
                        SelectedIndex="{Binding SelectedTab}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        SelectionChanged="TabControl_OnSelectionChanged">
                <TabItem Name="summaryTab" Header="{x:Static Properties:Resources.MainView_SummaryTab}">
                    <views:SummaryView DataContext="{Binding SummaryViewModel}"  />
                </TabItem>
                <TabItem Name="pictureTab" Header="{x:Static Properties:Resources.MainView_PictureTab}">
                    <views:PictureSettingsView DataContext="{Binding PictureSettingsViewModel}" />
                </TabItem>
                <TabItem Name="filtersTab" Header="{x:Static Properties:Resources.MainView_FiltersTab}">
                    <views:FiltersView  DataContext="{Binding FiltersViewModel}" />
                </TabItem>
                <TabItem Name="videoTab" Header="{x:Static Properties:Resources.MainView_VideoTab}">
                    <views:VideoView VerticalAlignment="Stretch" DataContext="{Binding VideoViewModel}" />
                </TabItem>
                <TabItem Name="audioTab" Header="{x:Static Properties:Resources.MainView_AudioTab}">
                    <views:AudioView DataContext="{Binding AudioViewModel}" />
                </TabItem>
                <TabItem Name="subtitlesTab" Header="{x:Static Properties:Resources.MainView_SubtitlesTab}">
                    <views:SubtitlesView DataContext="{Binding SubtitleViewModel}" />
                </TabItem>
                <TabItem Name="chaptersTab" Header="{x:Static Properties:Resources.MainView_ChaptersTab}">
                    <views:ChaptersView DataContext="{Binding ChaptersViewModel}"  />
                </TabItem>
            </TabControl>

            <!--  Right column: output, presets, summary  -->
            <ScrollViewer Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical">

                    <!--  Output  -->
                    <Border Style="{StaticResource WsqCard}" IsEnabled="{Binding HasSource, Converter={StaticResource booleanConverter}, ConverterParameter=false}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{x:Static Properties:Resources.MainView_Format}" Style="{StaticResource WsqLabel}" />
                            <ComboBox Name="ContainerSide" HorizontalAlignment="Stretch"
                                      ToolTip="{x:Static Properties:ResourcesTooltips.MainView_Mux}"
                                      ItemsSource="{Binding SummaryViewModel.OutputFormats, Converter={StaticResource enumComboConverter}}"
                                      SelectedItem="{Binding SummaryViewModel.SelectedOutputFormat, Converter={StaticResource enumComboConverter}}"
                                      AutomationProperties.Name="{x:Static Properties:Resources.MainView_Format}" />

                            <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="Margin" Value="0,3" />
                                    </Style>
                                </StackPanel.Resources>
                                <CheckBox Content="{x:Static Properties:Resources.MainView_WebOptimized}"
                                          IsChecked="{Binding Path=SummaryViewModel.Optimize}"
                                          ToolTip="{x:Static Properties:ResourcesTooltips.MainView_Optimise}"
                                          Visibility="{Binding SummaryViewModel.IsMkvOrWebm, Converter={StaticResource boolToVisConverter}, ConverterParameter=true}" />
                                <CheckBox Content="{x:Static Properties:Resources.MainView_AlignAVStart}"
                                          ToolTip="{x:Static Properties:ResourcesTooltips.MainView_AlignAVStart}"
                                          IsChecked="{Binding Path=SummaryViewModel.AlignAVStart}"
                                          Visibility="{Binding SummaryViewModel.IsMkvOrWebm, Converter={StaticResource boolToVisConverter}, ConverterParameter=true}" />
                                <CheckBox Content="{x:Static Properties:Resources.MainView_iPod5G}"
                                          ToolTip="{x:Static Properties:ResourcesTooltips.MainView_IpodAtom}"
                                          IsChecked="{Binding Path=SummaryViewModel.IPod5GSupport}"
                                          Visibility="{Binding SummaryViewModel.IsIpodAtomVisible, Converter={StaticResource boolToVisConverter}}" />
                                <CheckBox Content="{x:Static Properties:Resources.SummaryView_MetadataPassthru}"
                                          IsChecked="{Binding Path=SummaryViewModel.MetadataPassthru}" />
                            </StackPanel>

                            <TextBlock Text="{x:Static Properties:Resources.MainView_File}" Style="{StaticResource WsqLabel}" Margin="0,12,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Name="Destination" Grid.Column="0" behaviours:TextBoxBehavior.TripleClickSelectAll="True"
                                         VerticalContentAlignment="Center" MinHeight="30"
                                         ToolTip="{x:Static Properties:ResourcesTooltips.MainView_Destination}"
                                         Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Behaviors>
                                        <behaviours:DoubleClickFileBehaviours/>
                                    </i:Interaction.Behaviors>
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static Properties:Resources.MainView_OpenDirectory}" Command="{Binding RelayCommand}" CommandParameter="OpenDestinationDirectory" />
                                            <MenuItem Header="{x:Static Properties:Resources.MainView_AutonameRegenerate}" Command="{Binding RelayCommand}" CommandParameter="ReGenerateAutoName" />
                                            <Separator />
                                            <MenuItem Header="{x:Static Properties:Resources.MainView_OpenAutonamePreferences}" Command="{Binding RelayCommand}" CommandParameter="OpenAutonamePreferences" />
                                            <Separator />
                                            <MenuItem Command="ApplicationCommands.Cut" />
                                            <MenuItem Command="ApplicationCommands.Copy" />
                                            <MenuItem Command="ApplicationCommands.Paste" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                                <Button Name="DestinationBrowser" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource WsqButton}" MinHeight="30"
                                        ToolTip="{x:Static Properties:ResourcesTooltips.MainView_Browse}"
                                        AutomationProperties.Name="{x:Static Properties:Resources.Browse}"
                                        Command="{Binding RelayCommand}" CommandParameter="BrowseDestination">
                                    <TextBlock Style="{StaticResource WsqText}" Text="{x:Static Properties:Resources.Browse}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Presets (collapsible)  -->
                    <Border Style="{StaticResource WsqCard}" Margin="0,16,0,0" Padding="10">
                        <StackPanel Orientation="Vertical">
                            <Button x:Name="presetHeaderButton" Style="{StaticResource WsqSectionToggle}" Click="PresetHeader_OnClick"
                                    AutomationProperties.Name="{x:Static Properties:Resources.MainView_Presets}">
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{x:Static Properties:Resources.MainView_SelectedPresets}" Style="{StaticResource WsqLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedPreset.DisplayValue}" Style="{StaticResource WsqText}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                            <TextBlock Text="(Modified)" Margin="6,0,0,0" FontStyle="Italic" Style="{StaticResource WsqMutedText}"
                                                       Visibility="{Binding IsModifiedPreset, Converter={StaticResource boolToVisConverter}, TargetNullValue=Collapsed, FallbackValue=Collapsed}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Path Grid.Column="1" Width="12" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,2,0"
                                          Stroke="{DynamicResource Wsq.Muted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="M 0,0 L 6,6 L 12,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPresetPaneDisplayed}" Value="True">
                                                        <Setter Property="Data" Value="M 0,6 L 6,0 L 12,6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>

                            <StackPanel Orientation="Vertical" Margin="0,8,0,0" Visibility="{Binding IsPresetPaneDisplayed, Converter={StaticResource boolToVisConverter}}">
                                <Controls:PresetPaneControl x:Name="presetPaneControl" DataContext="{Binding}" Height="440" SelectedPreset="{Binding SelectedPreset}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            IsEnabled="{Binding HasSource, Converter={StaticResource booleanConverter}, ConverterParameter=false}">
                                    <Button Style="{StaticResource WsqButton}" Command="{Binding RelayCommand}" CommandParameter="PresetReSelect"
                                            AutomationProperties.Name="{x:Static Properties:Resources.MainView_Reload}">
                                        <TextBlock Style="{StaticResource WsqText}" Text="{x:Static Properties:Resources.MainView_Reload}" />
                                    </Button>
                                    <Button Style="{StaticResource WsqButton}" Margin="6,0,0,0" Command="{Binding RelayCommand}" CommandParameter="PresetAdd"
                                            AutomationProperties.Name="{x:Static Properties:Resources.MainView_SaveNewPreset}">
                                        <TextBlock Style="{StaticResource WsqText}" Text="{x:Static Properties:Resources.MainView_SaveNewPreset}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Summary  -->
                    <Border Style="{StaticResource WsqCard}" Margin="0,16,0,0"
                            Visibility="{Binding HasSource, Converter={StaticResource boolToVisConverter}}">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WsqText}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static Properties:Resources.MainView_SummaryTab}" Style="{StaticResource WsqLabel}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static Properties:Resources.MainView_Tracks}" Foreground="{DynamicResource Wsq.Muted}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SummaryViewModel.VideoTrackInfo}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SummaryViewModel.AudioTrackInfo}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SummaryViewModel.SubtitleTrackInfo}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SummaryViewModel.ChapterInfo}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static Properties:Resources.MainView_Filters}" Foreground="{DynamicResource Wsq.Muted}" Margin="0,8,0,2" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SummaryViewModel.FiltersInfo}" Margin="0,8,0,2" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static Properties:Resources.MainView_Size}" Foreground="{DynamicResource Wsq.Muted}" Margin="0,8,0,2" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SummaryViewModel.DimensionInfo}" Margin="0,8,0,2" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Source Selection-->
        <Controls:SourceSelection x:Name="sourceSelection"
                                  Grid.Row="0" Grid.RowSpan="3"
                                  Visibility="{Binding ShowSourceSelection, Converter={StaticResource boolToVisConverter}, ConverterParameter=false, TargetNullValue=Collapsed, FallbackValue=Collapsed}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  Panel.ZIndex="10" />

        <Controls:StatusPanel x:Name="loadingPanel"
                              Grid.Row="0"
                              Grid.RowSpan="3"
                              Visibility="{Binding ShowStatusWindow, Converter={StaticResource boolToVisConverter}, ConverterParameter=false, TargetNullValue=Collapsed, FallbackValue=Collapsed}"
                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              Panel.ZIndex="10"
                              IsLoading="{Binding ShowStatusWindow}"
                              Message="{x:Static Properties:Resources.MainView_ScanningStatus}"
                              SubMessage="{Binding StatusLabel}"
                              ActionText="{x:Static Properties:Resources.MainView_Cancel}"
                              SecondaryActionText="{x:Static Properties:Resources.MainView_OpenLog}"
                              SecondaryAction="{Binding OpenLogWindowAction}"
                              CancelAction="{Binding CancelAction}"
                              ProgressPercentage="{Binding ProgressAmount}" />

        <Controls:AlertPanel x:Name="alertPanel"
                             KeyboardNavigation.DirectionalNavigation="Contained"
                             Grid.Row="0"
                             Grid.RowSpan="3"
                             Visibility="{Binding ShowAlertWindow, Converter={StaticResource boolToVisConverter}, ConverterParameter=false, TargetNullValue=Collapsed, FallbackValue=Collapsed}"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             Panel.ZIndex="25"
                             Message="{Binding AlertWindowHeader}"
                             SubMessage="{Binding AlertWindowText}"
                             ActionText="OK"
                             DefaultAction="{Binding AlertWindowClose}">

        </Controls:AlertPanel>

        <!--  Status Bar  -->
        <StatusBar Name="statusBar" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                   Background="{DynamicResource Wsq.Surface}" BorderBrush="{DynamicResource Wsq.CardBorder}" BorderThickness="0,1,0,0" Padding="12,2">

            <StatusBarItem>
                <ProgressBar Value="{Binding ProgressPercentage}" IsIndeterminate="{Binding IsMultiProcess}"  Visibility="{Binding IsEncoding, Converter={StaticResource boolToVisConverter}}"
                             Width="140" Height="8" VerticalAlignment="Center" Foreground="{DynamicResource Wsq.Accent}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Path=ProgramStatusLabel}" TextTrimming="CharacterEllipsis" Style="{StaticResource WsqMutedText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" ToolTip="{x:Static Properties:ResourcesTooltips.MainView_WhenDone}">
                <Menu Background="Transparent" >
                    <MenuItem>
                        <MenuItem.Header>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" MinHeight="26">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource WsqMutedText}" Text="{x:Static Properties:Resources.QueueView_WhenDone}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource WsqText}" Text="{Binding QueueViewModel.WhenDoneAction, Converter={StaticResource enumComboConverter}}" />
                                <Path Height="5"
                                      Margin="6,2,2,0"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{DynamicResource ButtonGlyphBrush}" />
                            </StackPanel>
                        </MenuItem.Header>

                        <MenuItem x:Name="doNothing" Command="{Binding DataContext.WhenDoneCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StatusBar}}}" CommandParameter="0" Header="{x:Static Properties:Resources.WhenDone_DoNothing}" />
                        <MenuItem x:Name="shutdown" Command="{Binding DataContext.WhenDoneCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StatusBar}}}" CommandParameter="1" Header="{x:Static Properties:Resources.WhenDone_Shutdown}" />
                        <MenuItem x:Name="suspend" Command="{Binding DataContext.WhenDoneCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StatusBar}}}" CommandParameter="2" Header="{x:Static Properties:Resources.WhenDone_Suspend}" />
                        <MenuItem x:Name="hibernate" Command="{Binding DataContext.WhenDoneCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StatusBar}}}" CommandParameter="3" Header="{x:Static Properties:Resources.WhenDone_Hibernate}"/>
                        <MenuItem x:Name="lock" Command="{Binding DataContext.WhenDoneCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StatusBar}}}" CommandParameter="4" Header="{x:Static Properties:Resources.WhenDone_LockSystem}" />
                        <MenuItem x:Name="logoff" Command="{Binding DataContext.WhenDoneCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StatusBar}}}" CommandParameter="5" Header="{x:Static Properties:Resources.WhenDone_Logoff}"/>
                        <MenuItem x:Name="quit" Command="{Binding DataContext.WhenDoneCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StatusBar}}}" CommandParameter="6" Header="{x:Static Properties:Resources.WhenDone_QuitHandBrake}"/>
                    </MenuItem>
                </Menu>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
