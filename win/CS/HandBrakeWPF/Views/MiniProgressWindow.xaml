<Window x:Class="HandBrakeWPF.Views.MiniProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Properties="clr-namespace:HandBrakeWPF.Properties"
        Title="HandBrake"
        Width="112" Height="112"
        PreviewMouseWheel="Window_OnPreviewMouseWheel"
        LocationChanged="Window_OnLocationChanged"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">

    <!-- WsQ mini progress indicator (variant B): 270° gauge, percent + time left in the middle, fps in the gap.
         Shift + mouse wheel scales it; position and scale are remembered. -->
    <Grid x:Name="root" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding ElementName=statusTip, Path=Text}">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="showMainMenuItem" Header="{x:Static Properties:Resources.MiniProgress_ShowMain}" Click="ShowMain_OnClick" />
                <MenuItem x:Name="pauseResumeMenuItem" Header="{x:Static Properties:Resources.MiniProgress_PauseResume}" Click="PauseResume_OnClick" />
                <MenuItem x:Name="topmostMenuItem" Header="{x:Static Properties:Resources.MiniProgress_Topmost}" IsCheckable="True" IsChecked="True" Click="Topmost_OnClick" />
                <Separator />
                <MenuItem x:Name="hideMenuItem" Header="{x:Static Properties:Resources.MiniProgress_Hide}" Click="Hide_OnClick" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Ellipse Fill="{DynamicResource Wsq.Card}" Stroke="{DynamicResource Wsq.CardBorder}" StrokeThickness="1">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="Black" />
            </Ellipse.Effect>
        </Ellipse>

        <Path x:Name="trackArc" Stroke="{DynamicResource Wsq.Input}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Path x:Name="progressArc" Stroke="{DynamicResource Wsq.Accent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8">
            <TextBlock x:Name="percentText" Text="0%" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Wsq.Text}" />
            <TextBlock x:Name="etaText" Text="" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0"
                       Foreground="{DynamicResource Wsq.Muted}" />
        </StackPanel>

        <TextBlock x:Name="fpsText" Text="" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7"
                   Foreground="{DynamicResource Wsq.Accent}" />

        <!-- Play / pause badge in the bottom-right corner: starts / resumes or pauses encoding. -->
        <Border x:Name="playBadge" Width="24" Height="24" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                Background="{DynamicResource Wsq.Input}" BorderBrush="{DynamicResource Wsq.CardBorder}" BorderThickness="1" Cursor="Hand"
                ToolTip="{x:Static Properties:Resources.MiniProgress_PauseResume}"
                MouseLeftButtonDown="PlayBadge_OnMouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.45" Color="Black" />
            </Border.Effect>
            <Grid>
                <Path x:Name="playIcon" Data="M 0,0 L 8,5 L 0,10 Z" Fill="{DynamicResource Wsq.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed" />
                <Path x:Name="pauseIcon" Data="M 0,0 H 3 V 10 H 0 Z M 5,0 H 8 V 10 H 5 Z" Fill="{DynamicResource Wsq.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock x:Name="statusTip" Visibility="Collapsed" />
    </Grid>
</Window>
